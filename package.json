{
  "name": "brivexis-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server.js",
    "build:og": "node scripts/generate-og.mjs",
    "start": "node server.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true})\"",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:e2e:home": "npm run build && vitest run --config vitest.e2e.config.ts e2e/home",
    "test:e2e:contractor": "npm run build && vitest run --config vitest.e2e.config.ts e2e/contractor",
    "test:e2e:dealer": "npm run build && vitest run --config vitest.e2e.config.ts e2e/dealer",
    "test:e2e:distribution": "npm run build && vitest run --config vitest.e2e.config.ts e2e/distribution",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run lint && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
