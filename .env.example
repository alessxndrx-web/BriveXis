# ---------------------------------------------------------------------------
# BriveXis — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
# VITE_* variables are inlined into the client bundle at build time, so they
# are PUBLIC. Everything else is read only by the Node server.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------

# Port the Express server listens on. Defaults to 8080.
PORT=8080

# --- Contact form delivery (server-side) -----------------------------------
# All three are required for the inquiry form to send. While any is missing the
# endpoint returns a 503 and the form tells the visitor it is unavailable —
# it never reports a false success.

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives project inquiries.
CONTACT_RECIPIENT_EMAIL=

# Verified sender address on your Resend domain, e.g. "BriveXis <inquiries@yourdomain.com>".
# The domain must be verified in Resend or delivery will be rejected.
CONTACT_FROM_EMAIL=

# Spam brake: submissions allowed per IP per window. Defaults: 5 per hour.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MS=3600000

# --- Public site values (client bundle) ------------------------------------

# Canonical origin, no trailing slash. Used by canonical links, Open Graph URLs
# and JSON-LD. Defaults to https://brivexis.com when unset.
VITE_SITE_URL=https://brivexis.com

# Overrides the inquiry endpoint. Leave empty for the default same-origin
# /api/contact — only needed if the API is hosted on another origin.
VITE_CONTACT_ENDPOINT=

# Public contact channels. Each is rendered on the site ONLY when set, so leave
# them empty until the real accounts exist rather than filling in a placeholder.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_LINKEDIN_URL=
